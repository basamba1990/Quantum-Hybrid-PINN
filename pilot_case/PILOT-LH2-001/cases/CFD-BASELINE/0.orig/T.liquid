FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T.liquid;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 21.01;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 21.01;
    }

    outlet
    {
        type            inletOutlet;
        phi             phi.liquid;
        inletValue      uniform 21.01;
        value           uniform 21.01;
    }

    wall1
    {
        type            zeroGradient;
    }

    wall2
    {
        // Saturated LH2 wall temperature at p=125310 Pa.
        // The former heat-flux boundary used default Tmin=273 K and
        // generated the non-physical first-step value T=147.005 K.
        type            fixedValue;
        value           uniform 21.01;
    }

    defaultFaces
    {
        type            empty;
    }
}


