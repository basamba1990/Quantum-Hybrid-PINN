{
    specie
    {
        nMoles 1;
        molWeight 2.01588;
    }
    equationOfState
    {
        // NIST saturation vapor density interpolation; use only within the declared saturation range.
        rho
        (
            (21.010 1.6229)
            (21.510 1.839)
            (22.010 2.0757)
            (22.510 2.3346)
            (23.010 2.6173)
