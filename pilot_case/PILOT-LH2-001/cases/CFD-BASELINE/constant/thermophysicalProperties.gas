/* NIST SRD 69 saturation-derived parahydrogen properties; see source registry. */
FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object thermophysicalProperties.vapor;
}
thermoType
{
    type heRhoThermo;
    mixture pureMixture;
    transport const;
    thermo coolPropThermo;
    equationOfState icoTabulated;
    specie specie;
    energy sensibleEnthalpy;
}
