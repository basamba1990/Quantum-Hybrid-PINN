flowchart LR
  %% Pipeline de déblocage sans partenaire industriel
  subgraph P[Pipeline de preuve LH₂]
    B0[Benchmark analytique ou expérimental simple] --> B1[Prototype VOF fluide de référence]
    B1 --> B2[Test thermodynamique parahydrogène]
    B2 --> B3[Cas LH₂ académique reproductible]
    B3 --> B4[CAD autorisé du projet]
    B4 --> B5[Calcul cryogénique de production]
    B5 --> B6[Artefacts bruts + VTU]
    B6 --> B7[Sidecar + SHA-256]
    B7 --> B8[Préflight QuantumPINN]
    B8 --> B9[Import QuantumPINN]
    B9 --> B10[UNVALIDATED]
    B10 --> B11[Validation indépendante G0–G6]
  end

  subgraph A[Entrées hashées]
    CAD[CAD autorisé\nSTEP/IGES ou référence protégée]
    MESH[Maillage volumique\nSU2/CGNS/OpenFOAM]
    THERMO[Table parahydrogène\nEOS + transport + p_sat]
    BC[Conditions limites\ninitiales + paroi + pression]
    SOLVER[Solveur + code commit\nimage Docker + digest]
  end

  CAD --> B4
  MESH --> B4
  THERMO --> B5
  BC --> B5
  SOLVER --> B5

  subgraph S[Sidecar JSON lh2-cfd-sidecar.v1]
    META[Identité\ncase_id + run_id + statut]
    ENV[Environnement\nsolveur + version + commit + digest]
    GEO[Géométrie\nnom + SHA-256 + autorisation]
    MG[Maillage\nnom + SHA-256 + qualité]
    TP[Thermodynamique\nfluide + état de spin + domaine T-p]
    NUM[Numérique\nVOF + phase change + pas de temps]
    CONV[Convergence\nrésidus + bilans + boil-off]
    FR[Frames VTU\nfichier + hash + temps + champs]
    GATES[G0–G6\nINCONCLUSIVE jusqu'à preuve]
    META --> ENV
    META --> GEO
    META --> MG
    META --> TP
    META --> NUM
    META --> CONV
    META --> FR
    META --> GATES
  end

  B7 --> META
  GEO -. hash .-> CAD
  MG -. hash .-> MESH
  TP -. hash .-> THERMO
  ENV -. digest .-> SOLVER

  subgraph Q[QuantumPINN]
    PF[preflight_manifest.py]
    VA[verify_artifacts.py]
    IM[import_quantumpinn.py]
    PF --> VA --> IM
  end

  B8 --> PF
  S --> PF
  IM --> B10

  classDef blocked fill:#fff3cd,stroke:#9a6700,color:#111;
  classDef validated fill:#e8f5e9,stroke:#2e7d32,color:#111;
  classDef artifact fill:#e3f2fd,stroke:#1565c0,color:#111;
  class B0,B1,B2,B3,B4,B5 blocked;
  class B6,B7,S artifact;
  class B10 blocked;
  class B11 validated;
